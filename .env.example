# Meta Model API (OpenAI-compatible). Leave empty to run Bulbu fully offline:
# text logging, forecasts, what-ifs, patterns and coaching all work without a key.
META_API_BASE_URL=
META_API_KEY=
# Model IDs as listed in your Meta Model API console
MUSE_SPARK_MODEL=muse-spark
MUSE_WONDER_MODEL=muse-wonder

# API port (the web dev server proxies /api to it)
PORT=8787
# SQLite file (default: server/data/bulbu.db)
# BULBU_DB=
